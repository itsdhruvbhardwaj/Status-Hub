<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude preferences -->
        <exclude domain="sharedpref" path="statushub_prefs.xml"/>
        <exclude domain="sharedpref" path="statushub_autosave_log.xml"/>
        <exclude domain="sharedpref" path="auto_save_prefs.xml"/>

        <!-- Exclude the Room database to ensure history starts empty after reinstallation -->
        <exclude domain="database" path="status_hub_database"/>
        <exclude domain="database" path="status_hub_database-shm"/>
        <exclude domain="database" path="status_hub_database-wal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="statushub_prefs.xml"/>
        <exclude domain="sharedpref" path="statushub_autosave_log.xml"/>
        <exclude domain="sharedpref" path="auto_save_prefs.xml"/>
        <exclude domain="database" path="status_hub_database"/>
    </device-transfer>
</data-extraction-rules>